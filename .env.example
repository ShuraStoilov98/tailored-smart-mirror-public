# Copy to secrets/.env (ignored). Environment variables take precedence.
OPENAI_API_KEY=replace-with-your-local-key  # pragma: allowlist secret
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
MIRROR_CAMERA_INDEX=0
# BCM23 = physical pin 16 on Raspberry Pi 4's 40-pin header.
MIRROR_LED_PIN=23
